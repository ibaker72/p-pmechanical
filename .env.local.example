# --- Site ---
NEXT_PUBLIC_SITE_URL=https://ppmechanicalllc.com

# --- Supabase (lead storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
OWNER_EMAIL=

# --- Admin ---
# ADMIN_SECRET does two jobs:
#   1. Bearer token for GET /api/leads/list (as before).
#   2. The sign-in password for the /admin commercial estimating system.
# It must be at least 16 characters or admin sign-in stays disabled.
ADMIN_SECRET=

# Optional. Dedicated HMAC key for signing admin session cookies, so the
# sign-in password and the signing key can be rotated independently.
# Defaults to ADMIN_SECRET when unset.
ADMIN_SESSION_SECRET=

# Optional. Recorded in created_by / updated_by on estimating records.
# Defaults to "owner".
ADMIN_EMAIL=

# --- Commercial estimating system ---
# Private Supabase Storage bucket holding bid documents (plans, specs,
# addenda, vendor quotes). Created by migration 005; must NOT be public.
# Defaults to project-documents.
SUPABASE_DOCUMENTS_BUCKET=

# --- Rate limiting + idempotency (Upstash Redis) ---
# Required in production. Without these, the lead API and /admin/login still
# work but skip distributed rate limiting and idempotency — fine for dev,
# risky in prod.
#
# UPSTASH_REDIS_REST_URL must be the *REST* origin from the Upstash console:
# a bare https://<db>.upstash.io with no path and no trailing segments. A
# redis:// connection string or a URL with a path is rejected at startup, and
# the app falls back to a stricter in-process limiter (see lib/ratelimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Webhook authentication ---
# If set, the /api/leads/webhook route requires X-Webhook-Secret to match.
# Leave blank to accept unauthenticated webhooks (rate-limited by IP).
WEBHOOK_SECRET=

# --- Outbound webhook (OpenClaw / n8n / Make / Zapier) ---
# Where to POST `lead.created` events. Payload is signed with HMAC-SHA256
# in the X-Signature header using OUTBOUND_WEBHOOK_SECRET.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=

# --- Optional: business contact info exposed to the client ---
NEXT_PUBLIC_BUSINESS_PHONE=+1-201-456-5151
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=(201) 456-5151

# --- OpenClaw (server-side AI gateway for lead automation / prompts) ---
# All OpenClaw calls happen server-side. OPENCLAW_API_KEY is NEVER exposed to
# the browser. When OPENCLAW_ENABLED is not "true" (or URL/key are missing),
# every OpenClaw feature degrades to a clean fallback and the lead form still
# works exactly as before.
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
OPENCLAW_MODEL=gpt-4o-mini
OPENCLAW_TIMEOUT_MS=15000
# Optional: override if your gateway uses a non-OpenAI chat route.
OPENCLAW_CHAT_PATH=/v1/chat/completions
# Optional: if set, internal OpenClaw routes require x-internal-secret to match.
OPENCLAW_INTERNAL_SECRET=

# --- Anthropic (direct Claude API for AI SEO page generation) ---
# Required only for the new /api/generate-city-page and the weekly refresh
# cron. The key is server-only and must never be exposed to the browser.
# Leave blank to disable the AI page generator — existing static /locations
# pages continue to work either way.
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-sonnet-4-6, https://api.anthropic.com/v1,
# 90s timeout.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_BASE_URL=
ANTHROPIC_TIMEOUT_MS=

# --- Cron / internal protection ---
# Long random string. Used as:
#   - x-cron-secret header on /api/generate-city-page
#   - Authorization: Bearer ${CRON_SECRET} or x-cron-secret on
#     /api/cron/refresh-geo-pages
CRON_SECRET=
